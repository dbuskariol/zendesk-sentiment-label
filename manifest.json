{
  "manifest_version": 3,
  "name": "Zendesk Sentiment Label",
  "version": "1.0.1",
  "description": "Keeps Zendesk ticket sentiment controls consistent.",
  "action": {
    "default_title": "Zendesk Sentiment Label",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.zendesk.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.zendesk.com/*"
      ],
      "js": [
        "content/sentiment-label.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
